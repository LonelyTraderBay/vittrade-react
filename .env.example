# ─── VitTrade frontend environment ─────────────────────────────
# Copy to `.env.local` for local overrides. Never commit real values.
# All variables MUST be prefixed with VITE_ to reach the client.

# Local UI preview: use deterministic fixtures. Use `api` when a backend is available.
VITE_DATA_SOURCE=mock

# Base URL of the backend API (no trailing slash)
VITE_API_BASE_URL=https://api.example.invalid

# WebSocket endpoint for live market data
VITE_WS_URL=wss://ws.example.invalid

# Public app metadata
VITE_APP_NAME=VitTrade
VITE_RELEASE_VERSION=local

# Feature switches ("true" / "false")
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEVTOOLS=true
